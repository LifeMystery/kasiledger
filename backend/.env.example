# Copy this file to .env and adjust. Everything below is free.

# ---- AI providers (the "upgrade switches") ----
# EXTRACTOR: rule_based (free, needs simple format) | ollama (free, local LLM, understands sentences)
EXTRACTOR=rule_based
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# SPEECH: none (voice notes disabled) | local_whisper (free, run: pip install -r requirements-voice.txt)
SPEECH=none
WHISPER_MODEL=base

# OCR: tesseract (free, needs the Tesseract program installed) | none
OCR=tesseract
# Windows only, if Tesseract is not on your PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Messaging channels (all optional; the built-in simulator always works) ----
# Telegram: create a bot with @BotFather, paste the token. Polling mode needs no public URL.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling

# WhatsApp Cloud API (Meta developer test number - free for development)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=kasiledger-verify

# Public URL of this API (used for report links sent on WhatsApp). For local use leave as is.
PUBLIC_BASE_URL=http://localhost:8000

# Dashboard origin allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Daily summary: send to every business at this local time (HH:MM). Leave empty to disable.
DAILY_SUMMARY_TIME=
